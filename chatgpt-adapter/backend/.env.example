# Local-only default. For remote deployment, put the server behind a properly
# implemented OAuth 2.1 resource server; do not publish this sample endpoint open.
ARS_MCP_TRANSPORT=stdio
ARS_HOST=127.0.0.1
ARS_PORT=8000
CROSSREF_MAILTO=your-email@example.org

# Persistent SQLite workflow state (mount /data as a durable volume in container deployments)
ARS_STATE_DB=/data/ars_state.sqlite3

# Streamable HTTP safety controls. Defaults accept only loopback Host/Origin values.
# For a remote deployment, configure exact public Host values and trusted browser origins.
# Example: ARS_ALLOWED_HOSTS=ars-mcp.example.org,ars-mcp.example.org:*
# Example: ARS_ALLOWED_ORIGINS=https://chatgpt.com
ARS_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
ARS_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*
ARS_MAX_MCP_REQUEST_BYTES=12582912
